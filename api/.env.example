DATABASE_URL="postgresql://postgres:password@localhost:5432/tlaka_treats"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=3000
NODE_ENV=development

# Public URL of this API (used for PDF links in WhatsApp messages)
APP_URL=https://your-api-url.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Works with Gmail App Password, SendGrid, Mailgun SMTP, etc.
# For Gmail: enable 2FA → create App Password → use that as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Tlaka Treats <hello@tlakatreats.co.za>"
# Admin email for internal alerts (low stock). Defaults to SMTP_USER if not set.
ADMIN_EMAIL=admin@tlakatreats.co.za

# ── AI Advisory Board ─────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp via Twilio ───────────────────────────────────────────────────
# Sign up at twilio.com → enable WhatsApp sandbox → get credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox number (default below) or your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Odoo (external API — JSON-RPC) ────────────────────────────────────────
# Creates a res.partner contact in Odoo whenever a customer is created
# (self-registration or admin-created with the CUSTOMER role).
# Generate an API key in Odoo: Settings → Users → (your technical user) → API Keys.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-db-name
ODOO_USERNAME=integration@yourcompany.com
ODOO_API_KEY=your-odoo-api-key
# Exact name of the company (Settings → Companies) contacts should be created under
ODOO_COMPANY_NAME=Tlaka Treats

# Order → draft customer invoice sync (runs when an order is confirmed)
# If false (default), an order line with no Odoo product mapping fails the sync with a
# clear error instead of silently creating a new product in Odoo.
ODOO_AUTO_CREATE_PRODUCTS=false
# default_code of the Odoo products used for the delivery-fee and order-level-discount lines
ODOO_DELIVERY_PRODUCT_REF=DELIVERY-FEE
ODOO_DISCOUNT_PRODUCT_REF=DISCOUNT
# account.account codes (e.g. "500040") for those two lines' revenue, since they aren't tied
# to a Category. Leave unset to let Odoo use the product's own default income account.
ODOO_DELIVERY_INCOME_ACCOUNT_CODE=
ODOO_DISCOUNT_INCOME_ACCOUNT_CODE=
